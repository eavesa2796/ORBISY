## Copy to .env.local for local development.
## Prisma CLI and local scripts also load .env.local, with .env as a fallback.
## Example:
## DATABASE_URL=postgresql://postgres:postgres@localhost:5432/orbisy?schema=public

RESEND_API_KEY=
CONTACT_TO=
CONTACT_FROM=
DATABASE_URL=
NEXT_PUBLIC_CALENDLY_URL=

# Outreach Module Configuration
CRON_SECRET=
INBOUND_WEBHOOK_SECRET=
UNSUBSCRIBE_SECRET=
OUTREACH_SENDER_NAME=
OUTREACH_FROM_EMAIL=
NEXT_PUBLIC_URL=
GOOGLE_PLACES_API_KEY=

# Proposal follow-up automation
PROPOSAL_FOLLOW_UP_DAYS=2
PROPOSAL_MAX_FOLLOW_UPS=2
PROPOSAL_FOLLOW_UP_BATCH_LIMIT=20
